import { ScrollView } from "std-widgets.slint";
import "./fonts/Inter.ttf";

export struct ProfileItem {
    id: string,
    name: string,
    initials: string,
    subdomain: string,
    is_business: bool,
    avatar: image,
    has_avatar: bool,
    color_index: int,
}

export struct CourseItem {
    id: int,
    title: string,
    image_url: string,
    thumb: image,
    url: string,
    selected: bool,
}

export struct DownloadRow {
    lecture_id: int,
    course_title: string,
    lecture_title: string,
    status_text: string,
    progress: float,
    progress_text: string,
    speed_text: string,
    eta_text: string,
    is_active: bool,
}

export struct CurriculumLecture {
    id: int,
    index: int,
    title: string,
    item_type: string, // "chapter", "lecture", "quiz", "practice"
    asset_type: string, // "Video", "Article", "Quiz"
    duration_text: string,
}

export struct LocaleOption {
    code: string,
    name: string,
    country_code: string,
}

export global I18n {
    in-out property <[LocaleOption]> locales: [
        { code: "EnglishUS", name: "English (US)", country_code: "US" }
    ];
    in-out property <string> current_code: "EnglishUS";
    in-out property <string> current_name: "English (US)";
    in-out property <int> revision: 0;

    pure callback translate(string, string, int) -> string;

    public pure function t(key: string, fallback: string) -> string {
        return root.translate(key, fallback, root.revision);
    }
}

// Global Theme Configuration
export global Theme {
    in-out property <bool> is_dark: true;
    in-out property <int> preset: 0; // 0: Cyber Purple/Cyan, 1: Ocean Blue, 2: Emerald, 3: Crimson Rose, 4: Amber Gold

    // Primary & Secondary Accent Colors
    out property <color> accent: root.preset == 1 ? #2563eb
        : (root.preset == 2 ? #10b981
        : (root.preset == 3 ? #e11d48
        : (root.preset == 4 ? #f59e0b : #9333ea)));

    out property <color> accent_secondary: root.preset == 1 ? #00e5ff
        : (root.preset == 2 ? #34d399
        : (root.preset == 3 ? #fb7185
        : (root.preset == 4 ? #fbbf24 : #00e5ff)));

    out property <color> accent_glow: root.preset == 1 ? #2563eb55
        : (root.preset == 2 ? #10b98155
        : (root.preset == 3 ? #e11d4855
        : (root.preset == 4 ? #f59e0b55 : #b400ff55)));

    // Dynamic vector emblem gradients with theme palette adaptation
    out property <brush> logo_gradient: root.preset == 1
        ? @linear-gradient(90deg, #00e5ff 0%, #2563eb 100%)
        : (root.preset == 2
            ? @linear-gradient(90deg, #6ee7b7 0%, #059669 100%)
            : (root.preset == 3
                ? @linear-gradient(90deg, #fda4af 0%, #e11d48 100%)
                : (root.preset == 4
                    ? @linear-gradient(90deg, #fde047 0%, #ea580c 100%)
                    : @linear-gradient(90deg, #00e5ff 0%, #b400ff 100%))));

    out property <brush> text_gradient: root.preset == 1
        ? @linear-gradient(90deg, #38bdf8 0%, #2563eb 100%)
        : (root.preset == 2
            ? @linear-gradient(90deg, #34d399 0%, #059669 100%)
            : (root.preset == 3
                ? @linear-gradient(90deg, #fb7185 0%, #e11d48 100%)
                : (root.preset == 4
                    ? @linear-gradient(90deg, #fbbf24 0%, #ea580c 100%)
                    : @linear-gradient(90deg, #2563eb 0%, #a855f7 100%))));

    // Application background surface gradients derived from active theme preset
    out property <color> bg_app: root.is_dark
        ? (root.preset == 1 ? #050914 : (root.preset == 2 ? #040d0a : (root.preset == 3 ? #0f0508 : (root.preset == 4 ? #0f0a04 : #07060e))))
        : (root.preset == 1 ? #f0f7ff : (root.preset == 2 ? #f0fdf6 : (root.preset == 3 ? #fff1f2 : (root.preset == 4 ? #fffbeb : #faf5ff))));

    out property <color> bg_sidebar: root.is_dark
        ? (root.preset == 1 ? #080e1e : (root.preset == 2 ? #071510 : (root.preset == 3 ? #16080d : (root.preset == 4 ? #161006 : #0b0916))))
        : #ffffff;

    out property <color> bg_card: root.is_dark
        ? (root.preset == 1 ? #0d162c : (root.preset == 2 ? #0b1f18 : (root.preset == 3 ? #210d14 : (root.preset == 4 ? #211709 : #120f24))))
        : #ffffff;

    out property <color> bg_card_hover: root.is_dark
        ? (root.preset == 1 ? #13203d : (root.preset == 2 ? #102a21 : (root.preset == 3 ? #2d121c : (root.preset == 4 ? #2d200d : #191530))))
        : #f8fafc;

    out property <color> bg_card_secondary: root.is_dark
        ? (root.preset == 1 ? #111c36 : (root.preset == 2 ? #0e261d : (root.preset == 3 ? #281018 : (root.preset == 4 ? #281c0b : #16132b))))
        : #f1f5f9;

    out property <color> bg_input: root.is_dark
        ? (root.preset == 1 ? #070c18 : (root.preset == 2 ? #06110d : (root.preset == 3 ? #12060a : (root.preset == 4 ? #120d05 : #090812))))
        : #ffffff;

    out property <color> border_subtle: root.is_dark ? #ffffff18 : #e2e8f0;
    out property <color> border_hover: root.accent;
    out property <color> border_input: root.is_dark ? #ffffff24 : #cbd5e1;
    out property <color> text_primary: root.is_dark ? #ffffff : #0f172a;
    out property <color> text_secondary: root.is_dark ? #cbd5e1 : #475569;
    out property <color> text_muted: root.is_dark ? #64748b : #94a3b8;
    out property <color> card_shadow_color: root.is_dark ? #00000088 : #64748b26;
}

// Vector Graphics and Reusable UI Components

component SvgIcon {
    in property <string> commands: "";
    in property <color> stroke_color: #ffffff;
    in property <length> stroke_width: 2px;
    in property <color> fill_color: transparent;
    in property <length> size: 20px;
    in property <float> viewbox_width: 24;
    in property <float> viewbox_height: 24;

    width: root.size;
    height: root.size;

    Path {
        x: 0px;
        y: 0px;
        width: root.size;
        height: root.size;
        commands: root.commands;
        stroke: root.stroke_color;
        stroke-width: root.stroke_width;
        fill: root.fill_color;
        viewbox-width: root.viewbox_width;
        viewbox-height: root.viewbox_height;
    }
}

// Brand emblem vector geometry and glow layer
component BrandMark {
    in property <length> size: 64px;
    width: root.size;
    height: root.size;

    // Soft radial glow behind the vector emblem
    Rectangle {
        x: -root.size * 0.15;
        y: -root.size * 0.15;
        width: root.size * 1.3;
        height: root.size * 1.3;
        border-radius: self.width / 2;
        background: @radial-gradient(circle, Theme.accent_glow 0%, transparent 70%);
    }

    // Vector particle geometry mapped to viewbox coordinates
    Path {
        width: root.size;
        height: root.size;
        viewbox-x: 60;
        viewbox-y: 60;
        viewbox-width: 280;
        viewbox-height: 280;
        fill: Theme.logo_gradient;
        commands:
            "M 200 67 A 3 3 0 1 0 200 73 A 3 3 0 1 0 200 67 Z " +
            "M 160 83 A 2 2 0 1 0 160 87 A 2 2 0 1 0 160 83 Z " +
            "M 115 116 A 4 4 0 1 0 115 124 A 4 4 0 1 0 115 116 Z " +
            "M 150 103 A 2 2 0 1 0 150 107 A 2 2 0 1 0 150 103 Z " +
            "M 290 186 A 4 4 0 1 0 290 194 A 4 4 0 1 0 290 186 Z " +
            "M 275 213 A 2 2 0 1 0 275 217 A 2 2 0 1 0 275 213 Z " +
            "M 125 238 A 2 2 0 1 0 125 242 A 2 2 0 1 0 125 238 Z " +
            "M 310 262 A 3 3 0 1 0 310 268 A 3 3 0 1 0 310 262 Z " +
            "M 245 286 A 4 4 0 1 0 245 294 A 4 4 0 1 0 245 286 Z " +
            "M 140 307 A 3 3 0 1 0 140 313 A 3 3 0 1 0 140 307 Z " +
            "M 200 326 A 4 4 0 1 0 200 334 A 4 4 0 1 0 200 326 Z " +
            "M 240 76 A 4 4 0 1 0 240 84 A 4 4 0 1 0 240 76 Z " +
            "M 220 98 A 2 2 0 1 0 220 102 A 2 2 0 1 0 220 98 Z " +
            "M 180 106 A 4 4 0 1 0 180 114 A 4 4 0 1 0 180 106 Z " +
            "M 245 108 A 2 2 0 1 0 245 112 A 2 2 0 1 0 245 108 Z " +
            "M 280 112 A 3 3 0 1 0 280 118 A 3 3 0 1 0 280 112 Z " +
            "M 310 158 A 2 2 0 1 0 310 162 A 2 2 0 1 0 310 158 Z " +
            "M 90 167 A 3 3 0 1 0 90 173 A 3 3 0 1 0 90 167 Z " +
            "M 115 195 A 5 5 0 1 0 115 205 A 5 5 0 1 0 115 195 Z " +
            "M 325 206 A 4 4 0 1 0 325 214 A 4 4 0 1 0 325 206 Z " +
            "M 85 218 A 2 2 0 1 0 85 222 A 2 2 0 1 0 85 218 Z " +
            "M 285 237 A 3 3 0 1 0 285 243 A 3 3 0 1 0 285 237 Z " +
            "M 145 263 A 2 2 0 1 0 145 267 A 2 2 0 1 0 145 263 Z " +
            "M 105 266 A 4 4 0 1 0 105 274 A 4 4 0 1 0 105 266 Z " +
            "M 170 285 A 5 5 0 1 0 170 295 A 5 5 0 1 0 170 285 Z " +
            "M 210 303 A 2 2 0 1 0 210 307 A 2 2 0 1 0 210 303 Z " +
            "M 270 313 A 2 2 0 1 0 270 317 A 2 2 0 1 0 270 313 Z";
    }

    // Center U Arc with rounded caps
    Path {
        width: root.size;
        height: root.size;
        viewbox-x: 60;
        viewbox-y: 60;
        viewbox-width: 280;
        viewbox-height: 280;
        stroke: Theme.logo_gradient;
        stroke-width: root.size * 0.092;
        fill: transparent;
        commands: "M 150 140 L 150 210 A 50 50 0 0 0 250 210 L 250 140";
    }
}

// Full Horizontal Brand Logo (Vector Emblem + UDELER REBORN Gradient Text)
component BrandLogo {
    in property <length> mark_size: 52px;
    in property <length> font_size: 22px;

    HorizontalLayout {
        spacing: 12px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            BrandMark {
                size: root.mark_size;
            }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 7px;
                Text {
                    text: "UDELER";
                    font-size: root.font_size;
                    font-weight: 900;
                    letter-spacing: 1.5px;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
                Text {
                    text: "REBORN";
                    font-size: root.font_size;
                    font-weight: 900;
                    letter-spacing: 1.5px;
                    color: Theme.text_gradient;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component CustomToggleSwitch {
    in-out property <bool> checked: false;
    callback toggled();

    width: 46px;
    height: 26px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 13px;
        background: root.checked ? Theme.accent : (Theme.is_dark ? #272a40 : #cbd5e1);
        drop-shadow-blur: root.checked ? 10px : 0px;
        drop-shadow-color: root.checked ? Theme.accent_glow : transparent;
        animate background { duration: 160ms; }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.checked = !root.checked;
                root.toggled();
            }
        }

        Rectangle {
            x: root.checked ? 23px : 3px;
            y: 3px;
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: #ffffff;
            drop-shadow-blur: 4px;
            drop-shadow-color: #00000040;
            animate x { duration: 160ms; easing: ease-in-out; }
        }
    }
}

component PrimaryGradientButton {
    in property <string> text: "";
    in property <string> icon_commands: "";
    in property <bool> enabled: true;
    in property <bool> loading: false;
    callback clicked();

    height: 50px;

    Rectangle {
        border-radius: 16px;
        background: !root.enabled
            ? (Theme.is_dark ? #ffffff12 : #cbd5e1)
            : Theme.logo_gradient;
        border-width: 1px;
        border-color: #ffffff30;
        drop-shadow-blur: touch.has-hover && root.enabled ? 22px : 14px;
        drop-shadow-color: root.enabled ? Theme.accent_glow : transparent;
        drop-shadow-offset-y: 4px;

        touch := TouchArea {
            enabled: root.enabled && !root.loading;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { root.clicked(); }
        }

        HorizontalLayout {
            alignment: center;
            spacing: 10px;

            if root.icon_commands != "" : VerticalLayout {
                alignment: center;
                SvgIcon {
                    commands: root.icon_commands;
                    stroke_color: #ffffff;
                    size: 18px;
                }
            }

            Text {
                text: root.text;
                color: #ffffff;
                font-size: 14px;
                font-weight: 800;
                vertical-alignment: center;
            }
        }
    }
}

component SecondaryDarkButton {
    in property <string> text: "";
    in property <string> icon_commands: "";
    in property <bool> enabled: true;
    callback clicked();

    height: 48px;

    Rectangle {
        border-radius: 16px;
        background: !root.enabled
            ? (Theme.is_dark ? #161826 : #f1f5f9)
            : (touch.has-hover ? (Theme.is_dark ? #282c42 : #e2e8f0) : (Theme.is_dark ? #1e2133 : #f8fafc));
        border-width: 1px;
        border-color: touch.has-hover && root.enabled ? Theme.border_hover : Theme.border_subtle;
        animate background { duration: 150ms; }

        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { root.clicked(); }
        }

        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            if root.icon_commands != "" : VerticalLayout {
                alignment: center;
                SvgIcon {
                    commands: root.icon_commands;
                    stroke_color: root.enabled ? Theme.text_primary : Theme.text_muted;
                    size: 16px;
                }
            }
            Text {
                text: root.text;
                color: root.enabled ? Theme.text_primary : Theme.text_muted;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
}

component PillButton {
    in property <string> text: "";
    in property <string> icon_commands: "";
    in property <color> icon_color: Theme.text_primary;
    callback clicked();

    height: 40px;

    Rectangle {
        border-radius: 12px;
        background: touch.has-hover
            ? (Theme.is_dark ? #ffffff18 : #0000000d)
            : (Theme.is_dark ? #ffffff0c : #ffffff);
        border-width: 1px;
        border-color: touch.has-hover ? Theme.border_hover : Theme.border_subtle;
        drop-shadow-blur: 10px;
        drop-shadow-color: Theme.card_shadow_color;
        animate background { duration: 150ms; }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 8px;
            alignment: center;
            if root.icon_commands != "" : VerticalLayout {
                alignment: center;
                SvgIcon {
                    commands: root.icon_commands;
                    stroke_color: root.icon_color;
                    size: 16px;
                }
            }
            Text {
                text: root.text;
                color: Theme.text_primary;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}

component CustomStyledInput {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "";
    in property <bool> is_password: false;
    in property <bool> enabled: true;
    in property <string> icon_commands: "";
    callback edited();

    height: 48px;
    min-width: 0px;

    Rectangle {
        border-radius: 14px;
        background: Theme.bg_input;
        border-width: 1.5px;
        border-color: input.has-focus ? #3b82f6 : Theme.border_input;
        animate border-color { duration: 150ms; }
        clip: true;

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 10px;
            alignment: stretch;

            if root.icon_commands != "" : VerticalLayout {
                alignment: center;
                SvgIcon {
                    commands: root.icon_commands;
                    stroke_color: input.has-focus ? #3b82f6 : Theme.text_muted;
                    size: 16px;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                clip: true;

                input := TextInput {
                    width: 100%;
                    height: 100%;
                    color: Theme.text_primary;
                    font-size: 13px;
                    font-weight: 500;
                    vertical-alignment: center;
                    single-line: true;
                    input-type: root.is_password ? InputType.password : InputType.text;
                    enabled: root.enabled;
                    edited => { root.edited(); }
                }

                if input.text == "" : Text {
                    x: 0px;
                    width: 100%;
                    height: 100%;
                    text: root.placeholder;
                    color: Theme.text_muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component TokenInputField {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "Paste your token here...";
    in property <bool> enabled: true;
    in-out property <bool> show_token: false;
    callback paste_clicked();
    callback edited();

    height: 48px;
    min-width: 0px;

    Rectangle {
        border-radius: 14px;
        background: Theme.bg_input;
        border-width: 1.5px;
        border-color: input.has-focus ? #3b82f6 : Theme.border_input;
        animate border-color { duration: 150ms; }
        clip: true;

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 12px;
            spacing: 10px;
            alignment: stretch;

            VerticalLayout {
                alignment: center;
                SvgIcon {
                    commands: "M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z";
                    stroke_color: input.has-focus ? #3b82f6 : Theme.text_muted;
                    size: 16px;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                clip: true;

                input := TextInput {
                    width: 100%;
                    height: 100%;
                    color: Theme.text_primary;
                    font-size: 13px;
                    font-weight: 500;
                    vertical-alignment: center;
                    single-line: true;
                    input-type: root.show_token ? InputType.text : InputType.password;
                    enabled: root.enabled;
                    edited => { root.edited(); }
                    key-pressed(event) => {
                        if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                            root.paste_clicked();
                            return accept;
                        }
                        return reject;
                    }
                }

                if input.text == "" : Text {
                    x: 0px;
                    width: 100%;
                    height: 100%;
                    text: root.placeholder;
                    color: Theme.text_muted;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }

            // Visibility toggle for masked credential input
            if input.text != "" : VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: 8px;
                    background: touch_eye.has-hover ? (Theme.is_dark ? #ffffff15 : #00000010) : transparent;

                    touch_eye := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.show_token = !root.show_token; }
                    }

                    HorizontalLayout {
                        alignment: center;
                        VerticalLayout {
                            alignment: center;
                            SvgIcon {
                                commands: root.show_token
                                    ? "M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"
                                    : "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z";
                                stroke_color: touch_eye.has-hover ? #3b82f6 : Theme.text_muted;
                                size: 16px;
                            }
                        }
                    }
                }
            }
        }
    }
}

component ProfileCircleCard {
    in property <ProfileItem> profile;
    in property <bool> manage_mode: false;
    in property <bool> disabled: false;
    callback selected();
    callback delete_clicked();

    width: 156px;
    height: 204px;

    property <brush> ring_gradient: root.profile.color_index == 1
        ? @linear-gradient(135deg, #2563eb 0%, #06b6d4 100%)
        : (root.profile.color_index == 2
            ? @linear-gradient(135deg, #10b981 0%, #059669 100%)
            : (root.profile.color_index == 3
                ? @linear-gradient(135deg, #e11d48 0%, #f43f5e 100%)
                : (root.profile.color_index == 4
                    ? @linear-gradient(135deg, #f59e0b 0%, #ea580c 100%)
                    : @linear-gradient(135deg, #9333ea 0%, #ec4899 100%))));

    VerticalLayout {
        alignment: center;
        spacing: 14px;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 132px;
                height: 132px;

                Rectangle {
                    y: touch_prof.has-hover ? -4px : 0px;
                    width: 132px;
                    height: 132px;
                    border-radius: 66px;
                    background: root.ring_gradient;
                    drop-shadow-blur: touch_prof.has-hover ? 28px : 14px;
                    drop-shadow-color: touch_prof.has-hover ? Theme.accent_glow : #00000066;
                    drop-shadow-offset-y: touch_prof.has-hover ? 8px : 4px;
                    animate y, drop-shadow-blur { duration: 180ms; easing: ease-out; }

                    Rectangle {
                        x: 4px;
                        y: 4px;
                        width: 124px;
                        height: 124px;
                        border-radius: 62px;
                        background: Theme.bg_card;
                        clip: true;

                        if root.profile.has_avatar : Image {
                            source: root.profile.avatar;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }

                        if !root.profile.has_avatar : Rectangle {
                            width: 100%;
                            height: 100%;
                            background: root.ring_gradient;

                            Text {
                                text: root.profile.initials;
                                color: #ffffff;
                                font-size: 40px;
                                font-weight: 900;
                                letter-spacing: 1px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    touch_prof := TouchArea {
                        enabled: !root.disabled;
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.manage_mode) {
                                root.delete_clicked();
                            } else {
                                root.selected();
                            }
                        }
                    }

                    if root.manage_mode : Rectangle {
                        width: 124px;
                        height: 124px;
                        x: 4px;
                        y: 4px;
                        border-radius: 62px;
                        background: #00000099;

                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border-radius: 22px;
                                    background: #ef4444;
                                    HorizontalLayout {
                                        alignment: center;
                                        VerticalLayout {
                                            alignment: center;
                                            SvgIcon {
                                                commands: "M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-4v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16";
                                                stroke_color: #ffffff;
                                                size: 20px;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.profile.is_business : Rectangle {
                        x: 78px;
                        y: 98px;
                        width: 48px;
                        height: 22px;
                        border-radius: 11px;
                        background: #0f172a;
                        border-width: 1.5px;
                        border-color: Theme.accent;

                        Text {
                            text: "PRO";
                            color: #ffffff;
                            font-size: 9px;
                            font-weight: 900;
                            letter-spacing: 0.8px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 2px;
            Text {
                text: root.profile.name;
                color: touch_prof.has-hover ? Theme.text_primary : Theme.text_secondary;
                font-size: 15px;
                font-weight: touch_prof.has-hover ? 800 : 600;
                horizontal-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.profile.is_business ? "\{root.profile.subdomain}.udemy.com" : "Personal Account";
                color: Theme.text_muted;
                font-size: 11px;
                font-weight: 500;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
}

component AddProfileCircleCard {
    in property <int> current_count: 0;
    callback clicked();

    width: 156px;
    height: 204px;

    VerticalLayout {
        alignment: center;
        spacing: 14px;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                y: touch_add.has-hover ? -4px : 0px;
                width: 132px;
                height: 132px;
                border-radius: 66px;
                background: touch_add.has-hover ? Theme.bg_card_hover : Theme.bg_card;
                border-width: 2px;
                border-color: touch_add.has-hover ? Theme.accent : Theme.border_subtle;
                drop-shadow-blur: touch_add.has-hover ? 24px : 12px;
                drop-shadow-color: touch_add.has-hover ? Theme.accent_glow : Theme.card_shadow_color;
                animate y, background, border-color, drop-shadow-blur { duration: 180ms; easing: ease-out; }

                touch_add := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.clicked(); }
                }

                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        SvgIcon {
                            commands: "M12 4v16m8-8H4";
                            stroke_color: touch_add.has-hover ? Theme.accent : Theme.text_muted;
                            size: 42px;
                            stroke_width: 2.5px;
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 2px;
            Text {
                text: "Add Account";
                color: touch_add.has-hover ? Theme.text_primary : Theme.text_secondary;
                font-size: 15px;
                font-weight: touch_add.has-hover ? 800 : 600;
                horizontal-alignment: center;
            }
            Text {
                text: "\{root.current_count} of 5 slots used";
                color: Theme.text_muted;
                font-size: 11px;
                font-weight: 500;
                horizontal-alignment: center;
            }
        }
    }
}

// Main Application Window Definition
export component MainWindow inherits Window {
    title: "Udeler Reborn v4";
    preferred-width: 1180px;
    preferred-height: 780px;
    min-width: 960px;
    min-height: 640px;
    background: Theme.bg_app;
    default-font-family: "Inter";

    // Application State properties
    in-out property <bool> is_logged_in: false;
    in-out property <string> user_name: "Guest";
    in-out property <int> active_tab: 0; // 0: Courses, 1: Downloads, 2: Settings, 3: About
    in-out property <int> active_downloads_count: 0;
    in-out property <bool> is_dark_mode <=> Theme.is_dark;
    in-out property <int> theme_preset <=> Theme.preset;
    in-out property <string> current_language: "en-US"; // "en-US" or "el-GR"
    in-out property <bool> show_language_menu: false;
    out property <bool> is_greek: root.current_language == "el-GR";

    // Multi-Account & Login Form State
    in-out property <[ProfileItem]> profiles: [];
    in-out property <bool> is_adding_account: false;
    in-out property <bool> is_managing_profiles: false;
    in-out property <string> login_token: "";
    in-out property <string> login_subdomain: "";
    in-out property <bool> is_business_login: false;
    in-out property <string> login_status_message: "";
    in-out property <bool> is_logging_in: false;
    in-out property <bool> is_auto_logging_in: false;
    in-out property <bool> show_token_help_modal: false;

    // Library Data
    in-out property <[CourseItem]> courses: [];
    in-out property <string> search_query: "";
    in-out property <bool> is_loading_courses: false;
    in-out property <string> library_status: "";

    // Downloads Data
    in-out property <[DownloadRow]> downloads: [];

    // Curriculum Modal State
    in-out property <bool> show_curriculum_modal: false;
    in-out property <int> curriculum_course_id: 0;
    in-out property <string> curriculum_course_title: "";
    in-out property <image> curriculum_course_thumb: @image-url("brand.png");
    in-out property <bool> is_loading_curriculum: false;
    in-out property <[CurriculumLecture]> curriculum_items: [];

    // Settings Data
    in-out property <string> setting_download_path: "";
    in-out property <int> setting_storage_mode: 0;
    in-out property <string> setting_profile_custom_path: "";
    in-out property <string> setting_video_quality: "Auto";
    in-out property <int> setting_max_concurrency: 3;
    in-out property <int> setting_speed_limit_kb: 0;
    in-out property <bool> setting_skip_subtitles: false;
    in-out property <bool> setting_skip_attachments: false;
    in-out property <bool> setting_auto_retry: true;
    in-out property <bool> setting_schedule_enabled: false;
    in-out property <string> setting_schedule_start: "01:00";
    in-out property <string> setting_schedule_end: "06:00";
    in-out property <bool> setting_close_to_tray: false;
    in-out property <bool> setting_vault_mode: false;
    in-out property <string> settings_save_status: "";
    in-out property <bool> has_unsaved_settings: false;
    in-out property <bool> show_unsaved_dialog: false;
    in-out property <int> pending_tab_switch: 0;

    // About Tab State
    in-out property <bool> is_checking_updates: false;
    in-out property <string> update_status_text: "Udeler Reborn v4.0.0 is the latest version available.";
    in-out property <bool> update_available: false;
    in-out property <string> update_release_url: "";

    // Callbacks to Rust
    callback select_theme_preset(int);
    callback select_language(string);
    callback select_profile(string);
    callback delete_profile(string);
    callback login_requested(string, string);
    callback browser_login_requested(string);
    callback paste_token_requested();
    callback logout_requested();
    callback toggle_theme();
    callback refresh_courses();
    callback search_query_changed(string);
    callback toggle_course_selection(int);
    callback select_all_courses(bool);
    callback download_selected_courses();
    callback download_single_course(int);
    callback open_course_content(int);
    callback close_course_content();
    callback download_entire_course(int);
    callback download_lecture_item(int, int);
    callback pause_all_downloads();
    callback resume_all_downloads();
    callback cancel_download(int);
    callback browse_download_path();
    callback browse_profile_custom_path();
    callback save_settings();
    callback confirm_discard_settings();
    callback cancel_discard_settings();
    callback check_for_updates();
    callback open_external_url(string);

    // Ambient background gradient illumination
    Rectangle {
        x: -140px;
        y: -140px;
        width: 620px;
        height: 620px;
        border-radius: 310px;
        background: @radial-gradient(circle, Theme.accent_glow 0%, transparent 70%);
    }
    Rectangle {
        x: parent.width - 460px;
        y: parent.height - 460px;
        width: 620px;
        height: 620px;
        border-radius: 310px;
        background: @radial-gradient(circle, Theme.accent_glow 0%, transparent 70%);
    }

    // Authentication View (Profile Selection & Sign-In)
    if !root.is_logged_in : VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 32px;
        alignment: space-between;

        // Top Bar: Language Selector (Left) + Theme Swatches & Light/Dark Mode (Right)
        HorizontalLayout {
            alignment: space-between;

            PillButton {
                icon_commands: "M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9";
                icon_color: Theme.accent;
                text: "\{I18n.current_name} ▾";
                clicked => { root.show_language_menu = !root.show_language_menu; }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                Rectangle {
                    height: 40px;
                    border-radius: 12px;
                    background: Theme.bg_card;
                    border-width: 1px;
                    border-color: Theme.border_subtle;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: Theme.card_shadow_color;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;
                        alignment: center;

                        Text {
                            text: I18n.t("views.login.theme", "Theme");
                            color: Theme.text_muted;
                            font-size: 11px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        for swatch[idx] in [#9333ea, #2563eb, #10b981, #e11d48, #f59e0b] : VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: root.theme_preset == idx ? 22px : 18px;
                                height: root.theme_preset == idx ? 22px : 18px;
                                border-radius: 11px;
                                background: swatch;
                                border-width: root.theme_preset == idx ? 2.5px : 0px;
                                border-color: #ffffff;
                                drop-shadow-blur: root.theme_preset == idx ? 8px : 0px;
                                drop-shadow-color: swatch;

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.select_theme_preset(idx); }
                                }
                            }
                        }
                    }
                }

                PillButton {
                    icon_commands: root.is_dark_mode
                        ? "M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                        : "M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z";
                    icon_color: root.is_dark_mode ? #fbbf24 : Theme.accent;
                    text: root.is_dark_mode
                        ? I18n.t("components.sidebar.lightMode", "Light Mode")
                        : I18n.t("components.sidebar.darkMode", "Dark Mode");
                    clicked => { root.toggle_theme(); }
                }
            }
        }

        // Profile Selection Mode
        if !root.is_adding_account && root.profiles.length > 0 : VerticalLayout {
            alignment: center;
            spacing: 32px;

            VerticalLayout {
                alignment: center;
                spacing: 14px;

                HorizontalLayout {
                    alignment: center;
                    BrandMark { size: 96px; }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    Text {
                        text: "UDELER";
                        font-size: 32px;
                        font-weight: 900;
                        letter-spacing: 2px;
                        color: Theme.text_primary;
                    }
                    Text {
                        text: "REBORN";
                        font-size: 32px;
                        font-weight: 900;
                        letter-spacing: 2px;
                        color: Theme.text_gradient;
                    }
                }

                Text {
                    text: root.is_managing_profiles
                        ? I18n.t("views.login.manageTitle", "Manage Accounts")
                        : I18n.t("views.login.whosLearning", "Who's learning today?");
                    color: Theme.text_primary;
                    font-size: 26px;
                    font-weight: 800;
                    letter-spacing: -0.5px;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.is_managing_profiles
                        ? I18n.t("views.login.manageSub", "Click any profile circle to remove it from this device.")
                        : I18n.t("views.login.selectProfileSub", "Select your profile to load your courses immediately.");
                    color: Theme.text_muted;
                    font-size: 14px;
                    font-weight: 500;
                    horizontal-alignment: center;
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 28px;

                for prof in root.profiles : ProfileCircleCard {
                    profile: prof;
                    manage_mode: root.is_managing_profiles;
                    disabled: root.is_logging_in || root.is_auto_logging_in;
                    selected => { root.select_profile(prof.id); }
                    delete_clicked => { root.delete_profile(prof.id); }
                }

                if root.profiles.length < 5 && !root.is_managing_profiles : AddProfileCircleCard {
                    current_count: root.profiles.length;
                    clicked => {
                        root.login_status_message = "";
                        root.is_adding_account = true;
                    }
                }
            }

            if root.login_status_message != "" : HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 460px;
                    background: Theme.bg_card;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.accent;
                    HorizontalLayout {
                        padding: 14px;
                        alignment: center;
                        Text {
                            text: root.login_status_message;
                            color: Theme.text_primary;
                            font-size: 13px;
                            font-weight: 600;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    height: 44px;
                    border-radius: 12px;
                    background: touch_manage.has-hover
                        ? (root.is_managing_profiles ? Theme.accent : Theme.bg_card_hover)
                        : (root.is_managing_profiles ? Theme.accent : transparent);
                    border-width: 1.5px;
                    border-color: root.is_managing_profiles ? Theme.accent : Theme.border_subtle;
                    animate background, border-color { duration: 150ms; }

                    touch_manage := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.is_managing_profiles = !root.is_managing_profiles; }
                    }

                    HorizontalLayout {
                        padding-left: 26px;
                        padding-right: 26px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: root.is_managing_profiles
                                ? I18n.t("words.done", "DONE")
                                : I18n.t("views.login.manageBtn", "MANAGE PROFILES");
                            color: root.is_managing_profiles
                                ? #ffffff
                                : (touch_manage.has-hover ? Theme.text_primary : Theme.text_muted);
                            font-size: 12px;
                            font-weight: 800;
                            letter-spacing: 1.5px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Account Sign-In Form Mode
        if root.is_adding_account || root.profiles.length == 0 : HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 480px;
                background: Theme.bg_card;
                border-radius: 32px;
                border-width: 1px;
                border-color: Theme.border_subtle;
                drop-shadow-blur: 36px;
                drop-shadow-color: Theme.card_shadow_color;
                drop-shadow-offset-y: 14px;

                VerticalLayout {
                    padding: 34px;
                    spacing: 16px;

                    if root.profiles.length > 0 : HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            height: 32px;
                            border-radius: 10px;
                            background: touch_back_prof.has-hover ? Theme.bg_card_secondary : transparent;
                            touch_back_prof := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.login_status_message = "";
                                    root.is_adding_account = false;
                                }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 12px;
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    SvgIcon {
                                        commands: "M10 19l-7-7m0 0l7-7m-7 7h18";
                                        stroke_color: Theme.text_secondary;
                                        size: 15px;
                                    }
                                }
                                Text {
                                    text: "\{I18n.t("views.login.backToProfiles", "Back to Profiles")} (\{root.profiles.length}/5)";
                                    color: Theme.text_secondary;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: center;
                            BrandMark { size: 78px; }
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text {
                                text: "UDELER";
                                font-size: 26px;
                                font-weight: 900;
                                letter-spacing: 1.5px;
                                color: Theme.text_primary;
                            }
                            Text {
                                text: "REBORN";
                                font-size: 26px;
                                font-weight: 900;
                                letter-spacing: 1.5px;
                                color: Theme.text_gradient;
                            }
                        }

                        Text {
                            text: I18n.t("views.login.linkAccountSub", "Link a Udemy account (up to 5 profiles supported)");
                            font-size: 13px;
                            font-weight: 500;
                            color: Theme.text_muted;
                            horizontal-alignment: center;
                        }
                    }

                    Rectangle {
                        background: Theme.bg_card_secondary;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: Theme.border_subtle;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 12px;

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                CustomToggleSwitch {
                                    checked <=> root.is_business_login;
                                }
                                Text {
                                    text: I18n.t("views.login.businessAccount", "Udemy Business Account");
                                    color: Theme.text_primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            if root.is_business_login : VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: I18n.t("views.login.orgSubdomain", "ORGANIZATION SUBDOMAIN");
                                    color: Theme.text_muted;
                                    font-size: 10px;
                                    font-weight: 800;
                                    letter-spacing: 1px;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "https://";
                                        color: Theme.text_muted;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    CustomStyledInput {
                                        horizontal-stretch: 1;
                                        placeholder: "your-company";
                                        text <=> root.login_subdomain;
                                    }
                                    Text {
                                        text: ".udemy.com";
                                        color: Theme.text_muted;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    PrimaryGradientButton {
                        icon_commands: "M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1";
                        text: root.is_auto_logging_in
                            ? I18n.t("views.login.waitingLogin", "Waiting for sign-in in popup...")
                            : (root.is_business_login
                                ? I18n.t("views.login.signInBusiness", "Sign in via Udemy Business")
                                : I18n.t("views.login.signInNormal", "Sign in securely via Udemy"));
                        loading: root.is_auto_logging_in;
                        enabled: !root.is_auto_logging_in && !root.is_logging_in;
                        clicked => {
                            root.browser_login_requested(root.is_business_login ? root.login_subdomain : "");
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 12px;
                        Rectangle { horizontal-stretch: 1; height: 1px; background: Theme.border_subtle; }
                        Text {
                            text: I18n.t("views.login.manualToken", "OR MANUAL TOKEN");
                            color: Theme.text_muted;
                            font-size: 10px;
                            font-weight: 800;
                            letter-spacing: 1px;
                        }
                        Rectangle { horizontal-stretch: 1; height: 1px; background: Theme.border_subtle; }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: I18n.t("views.login.udemyAccessToken", "Udemy Access Token");
                            color: Theme.text_secondary;
                            font-size: 12px;
                            font-weight: 600;
                        }

                        TokenInputField {
                            placeholder: I18n.t("views.login.tokenPlaceholder", "Paste your token here (Ctrl+V)...");
                            text <=> root.login_token;
                            enabled: !root.is_logging_in && !root.is_auto_logging_in;
                            paste_clicked => { root.paste_token_requested(); }
                        }

                        Rectangle {
                            height: 24px;
                            touch_help := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show_token_help_modal = true; }
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    SvgIcon {
                                        commands: "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z";
                                        stroke_color: touch_help.has-hover ? Theme.accent : Theme.text_muted;
                                        size: 14px;
                                    }
                                }
                                Text {
                                    text: I18n.t("views.login.howTo", "How to find your token");
                                    color: touch_help.has-hover ? Theme.accent : Theme.text_muted;
                                    font-size: 12px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        SecondaryDarkButton {
                            text: root.is_logging_in
                                ? I18n.t("views.login.connecting", "Saving & Connecting...")
                                : I18n.t("views.login.manualLogin", "Save Profile & Login");
                            enabled: !root.is_logging_in && !root.is_auto_logging_in && root.login_token != "";
                            clicked => {
                                root.login_requested(
                                    root.login_token,
                                    root.is_business_login ? root.login_subdomain : ""
                                );
                            }
                        }
                    }

                    if root.login_status_message != "" : Rectangle {
                        background: #ef44441a;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #ef444455;
                        HorizontalLayout {
                            padding: 12px;
                            alignment: center;
                            Text {
                                text: root.login_status_message;
                                color: #fca5a5;
                                font-size: 12px;
                                font-weight: 600;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Bottom Footer
        Text {
            text: I18n.t("views.login.endToEnd", "END-TO-END ENCRYPTED STORAGE • UP TO 5 ACCOUNTS");
            color: Theme.text_muted;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 2px;
            horizontal-alignment: center;
        }
    }

    // Authenticated Application Shell
    if root.is_logged_in : HorizontalLayout {
        width: 100%;
        height: 100%;

        // Primary Navigation Sidebar
        Rectangle {
            width: 256px;
            horizontal-stretch: 0;
            background: Theme.bg_sidebar;

            Rectangle {
                x: parent.width - 1px;
                y: 0px;
                width: 1px;
                height: parent.height;
                background: Theme.border_subtle;
            }

            VerticalLayout {
                padding: 18px;
                spacing: 16px;

                // Brand Emblem Header with Theme Adaptation
                HorizontalLayout {
                    alignment: center;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    BrandLogo {
                        mark_size: 40px;
                        font_size: 16px;
                    }
                }

                Rectangle { height: 1px; background: Theme.border_subtle; }

                // Navigation Tabs
                VerticalLayout {
                    spacing: 8px;

                    // Navigation Item: My Courses
                    Rectangle {
                        height: 46px;
                        border-radius: 12px;
                        background: root.active_tab == 0
                            ? #2563eb
                            : (touch_nav_0.has-hover ? (Theme.is_dark ? #ffffff0d : #0000000a) : transparent);
                        drop-shadow-blur: root.active_tab == 0 ? 14px : 0px;
                        drop-shadow-color: root.active_tab == 0 ? #2563eb55 : transparent;
                        drop-shadow-offset-y: 4px;
                        animate background { duration: 150ms; }

                        touch_nav_0 := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.has_unsaved_settings && root.active_tab == 2) {
                                    root.pending_tab_switch = 0;
                                    root.show_unsaved_dialog = true;
                                } else {
                                    root.active_tab = 0;
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            spacing: 12px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                SvgIcon {
                                    commands: "M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z";
                                    stroke_color: root.active_tab == 0 ? #ffffff : Theme.text_secondary;
                                    size: 18px;
                                }
                            }
                            Text {
                                text: "My Courses";
                                color: root.active_tab == 0 ? #ffffff : Theme.text_secondary;
                                font-size: 14px;
                                font-weight: root.active_tab == 0 ? 700 : 500;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Navigation Item: Downloads
                    Rectangle {
                        height: 46px;
                        border-radius: 12px;
                        background: root.active_tab == 1
                            ? #2563eb
                            : (touch_nav_1.has-hover ? (Theme.is_dark ? #ffffff0d : #0000000a) : transparent);
                        drop-shadow-blur: root.active_tab == 1 ? 14px : 0px;
                        drop-shadow-color: root.active_tab == 1 ? #2563eb55 : transparent;
                        drop-shadow-offset-y: 4px;
                        animate background { duration: 150ms; }

                        touch_nav_1 := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.has_unsaved_settings && root.active_tab == 2) {
                                    root.pending_tab_switch = 1;
                                    root.show_unsaved_dialog = true;
                                } else {
                                    root.active_tab = 1;
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    SvgIcon {
                                        commands: "M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4";
                                        stroke_color: root.active_tab == 1 ? #ffffff : Theme.text_secondary;
                                        size: 18px;
                                    }
                                }
                                Text {
                                    text: "Downloads";
                                    color: root.active_tab == 1 ? #ffffff : Theme.text_secondary;
                                    font-size: 14px;
                                    font-weight: root.active_tab == 1 ? 700 : 500;
                                    vertical-alignment: center;
                                }
                            }
                            if root.active_downloads_count > 0 : VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: #a855f7;
                                    Text {
                                        text: "\{root.active_downloads_count}";
                                        color: #ffffff;
                                        font-size: 11px;
                                        font-weight: 800;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Navigation Item: Settings
                    Rectangle {
                        height: 46px;
                        border-radius: 12px;
                        background: root.active_tab == 2
                            ? #2563eb
                            : (touch_nav_2.has-hover ? (Theme.is_dark ? #ffffff0d : #0000000a) : transparent);
                        drop-shadow-blur: root.active_tab == 2 ? 14px : 0px;
                        drop-shadow-color: root.active_tab == 2 ? #2563eb55 : transparent;
                        drop-shadow-offset-y: 4px;
                        animate background { duration: 150ms; }

                        touch_nav_2 := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.active_tab = 2; }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            spacing: 12px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                SvgIcon {
                                    commands: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z";
                                    stroke_color: root.active_tab == 2 ? #ffffff : Theme.text_secondary;
                                    size: 18px;
                                }
                            }
                            Text {
                                text: "Settings";
                                color: root.active_tab == 2 ? #ffffff : Theme.text_secondary;
                                font-size: 14px;
                                font-weight: root.active_tab == 2 ? 700 : 500;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Navigation Item: About
                    Rectangle {
                        height: 46px;
                        border-radius: 12px;
                        background: root.active_tab == 3
                            ? #2563eb
                            : (touch_nav_3.has-hover ? (Theme.is_dark ? #ffffff0d : #0000000a) : transparent);
                        drop-shadow-blur: root.active_tab == 3 ? 14px : 0px;
                        drop-shadow-color: root.active_tab == 3 ? #2563eb55 : transparent;
                        drop-shadow-offset-y: 4px;
                        animate background { duration: 150ms; }

                        touch_nav_3 := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.has_unsaved_settings && root.active_tab == 2) {
                                    root.pending_tab_switch = 3;
                                    root.show_unsaved_dialog = true;
                                } else {
                                    root.active_tab = 3;
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            spacing: 12px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                SvgIcon {
                                    commands: "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z";
                                    stroke_color: root.active_tab == 3 ? #ffffff : Theme.text_secondary;
                                    size: 18px;
                                }
                            }
                            Text {
                                text: "About";
                                color: root.active_tab == 3 ? #ffffff : Theme.text_secondary;
                                font-size: 14px;
                                font-weight: root.active_tab == 3 ? 700 : 500;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                Rectangle { height: 1px; background: Theme.border_subtle; }

                // Bottom Sidebar Controls
                VerticalLayout {
                    spacing: 10px;

                    // Support Me Button
                    Rectangle {
                        height: 44px;
                        border-radius: 12px;
                        background: touch_sidebar_sponsor.has-hover
                            ? (Theme.is_dark ? #ec489922 : #fce7f3)
                            : (Theme.is_dark ? #ffffff06 : #f8fafc);
                        border-width: 1px;
                        border-color: Theme.border_subtle;
                        animate background { duration: 150ms; }
                        touch_sidebar_sponsor := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open_external_url("https://github.com/sponsors/M3rcena"); }
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                SvgIcon {
                                    commands: "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z";
                                    fill_color: #ec4899;
                                    stroke_width: 0px;
                                    size: 16px;
                                }
                            }
                            Text {
                                text: "Support me";
                                color: touch_sidebar_sponsor.has-hover ? #ec4899 : Theme.text_primary;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Theme Toggle Button
                    Rectangle {
                        height: 44px;
                        border-radius: 12px;
                        background: touch_theme.has-hover
                            ? (Theme.is_dark ? #ffffff14 : #e2e8f0)
                            : (Theme.is_dark ? #ffffff08 : #f1f5f9);
                        border-width: 1px;
                        border-color: Theme.border_subtle;
                        animate background { duration: 150ms; }
                        touch_theme := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle_theme(); }
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                SvgIcon {
                                    commands: root.is_dark_mode
                                        ? "M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
                                        : "M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z";
                                    stroke_color: root.is_dark_mode ? #fbbf24 : #3b82f6;
                                    size: 16px;
                                }
                            }
                            Text {
                                text: root.is_dark_mode ? "Light Mode" : "Dark Mode";
                                color: Theme.text_primary;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Logout Button
                    Rectangle {
                        height: 44px;
                        border-radius: 12px;
                        background: touch_logout.has-hover
                            ? #ef4444
                            : (Theme.is_dark ? #ef44441a : #fef2f2);
                        border-width: 1px;
                        border-color: #ef444433;
                        animate background { duration: 150ms; }
                        touch_logout := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.logout_requested(); }
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                SvgIcon {
                                    commands: "M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1";
                                    stroke_color: touch_logout.has-hover ? #ffffff : #f87171;
                                    size: 16px;
                                }
                            }
                            Text {
                                text: "Logout";
                                color: touch_logout.has-hover ? #ffffff : #f87171;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Main Content Workspace
        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            // Course Library View
            if root.active_tab == 0 : VerticalLayout {
                padding: 32px;
                spacing: 22px;

                // Header Toolbar
                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: "My Courses";
                            color: Theme.text_primary;
                            font-size: 28px;
                            font-weight: 800;
                            letter-spacing: -0.6px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "(\{root.courses.length})";
                            color: Theme.text_muted;
                            font-size: 20px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        // Select All Button
                        Rectangle {
                            height: 42px;
                            border-radius: 12px;
                            background: touch_sel_all.has-hover
                                ? (Theme.is_dark ? #ffffff18 : #e2e8f0)
                                : (Theme.is_dark ? #ffffff0c : #ffffff);
                            border-width: 1px;
                            border-color: Theme.border_subtle;
                            animate background { duration: 150ms; }
                            touch_sel_all := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.select_all_courses(true); }
                            }
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                Text {
                                    text: "Select All";
                                    color: Theme.text_primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Search Input Pill
                        Rectangle {
                            width: 240px;
                            height: 42px;
                            border-radius: 12px;
                            background: Theme.bg_input;
                            border-width: 1.5px;
                            border-color: search_input.has-focus ? #3b82f6 : Theme.border_input;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                alignment: stretch;

                                VerticalLayout {
                                    alignment: center;
                                    SvgIcon {
                                        commands: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z";
                                        stroke_color: Theme.text_muted;
                                        size: 16px;
                                    }
                                }
                                search_input := TextInput {
                                    text <=> root.search_query;
                                    color: Theme.text_primary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    edited => { root.search_query_changed(self.text); }
                                }
                            }

                            if search_input.text == "" : HorizontalLayout {
                                padding-left: 36px;
                                alignment: stretch;
                                Text {
                                    text: "Search courses...";
                                    color: Theme.text_muted;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Refresh Button
                        Rectangle {
                            width: 42px;
                            height: 42px;
                            border-radius: 12px;
                            background: touch_refresh.has-hover
                                ? (Theme.is_dark ? #ffffff18 : #e2e8f0)
                                : (Theme.is_dark ? #ffffff0c : #ffffff);
                            border-width: 1px;
                            border-color: Theme.border_subtle;
                            animate background { duration: 150ms; }
                            touch_refresh := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.refresh_courses(); }
                            }
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    SvgIcon {
                                        commands: "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15";
                                        stroke_color: Theme.text_primary;
                                        size: 18px;
                                    }
                                }
                            }
                        }

                        // Download Selected Button
                        Rectangle {
                            height: 42px;
                            border-radius: 12px;
                            background: touch_dl_sel.has-hover
                                ? @linear-gradient(90deg, #3b82f6 0%, #9333ea 100%)
                                : @linear-gradient(90deg, #2563eb 0%, #7e22ce 100%);
                            border-width: 1px;
                            border-color: #ffffff25;
                            drop-shadow-blur: 12px;
                            drop-shadow-color: #2563eb55;
                            drop-shadow-offset-y: 3px;
                            animate background { duration: 150ms; }
                            touch_dl_sel := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.download_selected_courses(); }
                            }
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 8px;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    SvgIcon {
                                        commands: "M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4";
                                        stroke_color: #ffffff;
                                        size: 16px;
                                    }
                                }
                                Text {
                                    text: "Download Selected";
                                    color: #ffffff;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                if root.library_status != "" : Text {
                    text: root.library_status;
                    color: Theme.text_secondary;
                    font-size: 12px;
                    font-weight: 600;
                }

                // Responsive Course Cards Grid
                ScrollView {
                    vertical-stretch: 1;
                    grid_box := Rectangle {
                        property <int> cols: grid_box.width > 1100px ? 4 : (grid_box.width > 740px ? 3 : 2);
                        property <length> col_width: (grid_box.width - (self.cols - 1) * 20px) / self.cols;
                        property <length> thumb_height: self.col_width * 0.5625;
                        property <length> row_height: self.thumb_height + 124px;

                        height: Math.ceil(root.courses.length / self.cols) * (self.row_height + 20px) + 24px;

                        for course[i] in root.courses : Rectangle {
                            x: Math.mod(i, grid_box.cols) * (grid_box.col_width + 20px);
                            y: Math.floor(i / grid_box.cols) * (grid_box.row_height + 20px);
                            width: grid_box.col_width;
                            height: grid_box.row_height;
                            border-radius: 18px;
                            background: card_hover.has-hover ? Theme.bg_card_hover : Theme.bg_card;
                            border-width: course.selected ? 2px : 1px;
                            border-color: course.selected ? #2563eb : (card_hover.has-hover ? Theme.border_hover : Theme.border_subtle);
                            drop-shadow-blur: card_hover.has-hover ? 24px : 14px;
                            drop-shadow-color: Theme.card_shadow_color;
                            drop-shadow-offset-y: card_hover.has-hover ? 8px : 4px;
                            clip: true;

                            card_hover := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open_course_content(course.id); }
                            }

                            VerticalLayout {
                                alignment: stretch;

                                // Course Thumbnail Header (16:9 Aspect Ratio)
                                Rectangle {
                                    height: grid_box.thumb_height;
                                    clip: true;

                                    if course.thumb.width > 0 : Image {
                                        source: course.thumb;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: cover;
                                    }

                                    if course.thumb.width == 0 : Rectangle {
                                        width: 100%;
                                        height: 100%;
                                        background: @linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
                                        HorizontalLayout {
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                SvgIcon {
                                                    commands: "M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z";
                                                    stroke_color: #64748b;
                                                    size: 36px;
                                                }
                                            }
                                        }
                                    }

                                    // Top-Left Selection Checkbox
                                    Rectangle {
                                        x: 12px;
                                        y: 12px;
                                        width: 30px;
                                        height: 30px;
                                        border-radius: 10px;
                                        background: course.selected ? #2563eb : #00000077;
                                        border-width: 1.5px;
                                        border-color: course.selected ? #60a5fa : #ffffff55;

                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.toggle_course_selection(course.id);
                                            }
                                        }

                                        if course.selected : SvgIcon {
                                            commands: "M5 13l4 4L19 7";
                                            stroke_color: #ffffff;
                                            size: 16px;
                                            stroke_width: 3px;
                                            x: 7px;
                                            y: 7px;
                                        }
                                    }
                                }

                                // Course Card Body
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 12px;
                                    alignment: space-between;

                                    Rectangle {
                                        height: 40px;
                                        clip: true;
                                        Text {
                                            width: 100%;
                                            text: course.title;
                                            color: card_hover.has-hover ? #3b82f6 : Theme.text_primary;
                                            font-size: 14px;
                                            font-weight: 700;
                                            overflow: elide;
                                            wrap: word-wrap;
                                        }
                                    }

                                    // "View Content" Action Button
                                    Rectangle {
                                        height: 38px;
                                        border-radius: 12px;
                                        background: touch_view.has-hover || card_hover.has-hover
                                            ? #2563eb
                                            : (Theme.is_dark ? #0b0c14 : #f1f5f9);
                                        border-width: 1px;
                                        border-color: Theme.border_subtle;
                                        animate background { duration: 150ms; }

                                        touch_view := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.open_course_content(course.id);
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: "View Content";
                                                color: (touch_view.has-hover || card_hover.has-hover) ? #ffffff : Theme.text_secondary;
                                                font-size: 13px;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Downloads Queue and History View
            if root.active_tab == 1 : VerticalLayout {
                padding: 32px;
                alignment: start;

                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        max-width: 920px;
                        horizontal-stretch: 1;
                        spacing: 22px;

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "Queue & Downloads";
                                    font-size: 28px;
                                    font-weight: 800;
                                    letter-spacing: -0.6px;
                                    color: Theme.text_primary;
                                }
                                Text {
                                    text: "Monitor active transfers and manage background download workers.";
                                    font-size: 13px;
                                    color: Theme.text_muted;
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    height: 42px;
                                    border-radius: 12px;
                                    background: touch_pause.has-hover ? #eab308 : #eab30822;
                                    border-width: 1px;
                                    border-color: #eab30855;
                                    touch_pause := TouchArea { mouse-cursor: pointer; clicked => { root.pause_all_downloads(); } }
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            alignment: center;
                                            SvgIcon {
                                                commands: "M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z";
                                                stroke_color: touch_pause.has-hover ? #ffffff : #eab308;
                                                size: 16px;
                                            }
                                        }
                                        Text { text: "Pause All"; color: touch_pause.has-hover ? #ffffff : #eab308; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    height: 42px;
                                    border-radius: 12px;
                                    background: touch_resume.has-hover ? #22c55e : #22c55e22;
                                    border-width: 1px;
                                    border-color: #22c55e55;
                                    touch_resume := TouchArea { mouse-cursor: pointer; clicked => { root.resume_all_downloads(); } }
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            alignment: center;
                                            SvgIcon {
                                                commands: "M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z";
                                                stroke_color: touch_resume.has-hover ? #ffffff : #22c55e;
                                                size: 16px;
                                            }
                                        }
                                        Text { text: "Resume All"; color: touch_resume.has-hover ? #ffffff : #22c55e; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        if root.downloads.length == 0 : Rectangle {
                            height: 280px;
                            background: Theme.bg_card;
                            border-radius: 28px;
                            border-width: 1px;
                            border-color: Theme.border_subtle;
                            drop-shadow-blur: 16px;
                            drop-shadow-color: Theme.card_shadow_color;

                            VerticalLayout {
                                alignment: center;
                                spacing: 12px;
                                HorizontalLayout {
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        SvgIcon {
                                            commands: "M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4";
                                            stroke_color: Theme.text_muted;
                                            size: 44px;
                                        }
                                    }
                                }
                                Text { text: "No active downloads"; color: Theme.text_primary; font-size: 18px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: "Open any course in My Courses and click 'View Content' to start downloading."; color: Theme.text_muted; font-size: 13px; horizontal-alignment: center; }
                            }
                        }

                        if root.downloads.length > 0 : ScrollView {
                            height: 540px;
                            VerticalLayout {
                                spacing: 12px;
                                for item in root.downloads : Rectangle {
                                    height: 88px;
                                    background: Theme.bg_card;
                                    border-radius: 18px;
                                    border-width: 1px;
                                    border-color: Theme.border_subtle;
                                    drop-shadow-blur: 12px;
                                    drop-shadow-color: Theme.card_shadow_color;

                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 10px;

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: "\{item.course_title}  •  \{item.lecture_title}";
                                                color: Theme.text_primary;
                                                font-size: 13px;
                                                font-weight: 700;
                                                overflow: elide;
                                            }
                                            HorizontalLayout {
                                                spacing: 12px;
                                                Text {
                                                    text: item.status_text;
                                                    color: item.status_text == "Completed" ? #4ade80 : (item.status_text == "Downloading" ? #c084fc : Theme.text_muted);
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                                if item.is_active : Rectangle {
                                                    width: 64px;
                                                    height: 26px;
                                                    border-radius: 8px;
                                                    background: #ef444422;
                                                    border-width: 1px;
                                                    border-color: #ef444455;
                                                    TouchArea { mouse-cursor: pointer; clicked => { root.cancel_download(item.lecture_id); } }
                                                    Text { text: "Cancel"; color: #fca5a5; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                                }
                                            }
                                        }

                                        Rectangle {
                                            height: 6px;
                                            border-radius: 3px;
                                            background: Theme.is_dark ? #1e293b : #e2e8f0;
                                            Rectangle {
                                                x: 0px;
                                                y: 0px;
                                                width: parent.width * Math.max(0.0, Math.min(1.0, item.progress));
                                                height: 100%;
                                                border-radius: 3px;
                                                background: @linear-gradient(90deg, #3b82f6 0%, #9333ea 100%);
                                            }
                                        }

                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text { text: item.progress_text; color: Theme.text_muted; font-size: 11px; font-weight: 500; }
                                            Text { text: "\{item.speed_text}  •  ETA: \{item.eta_text}"; color: Theme.text_muted; font-size: 11px; font-weight: 500; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Application Settings View
            if root.active_tab == 2 : ScrollView {
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        max-width: 880px;
                        horizontal-stretch: 1;
                        padding: 32px;
                        spacing: 22px;

                        Text {
                            text: I18n.t("views.settings.title", "Application Settings");
                            font-size: 28px;
                            font-weight: 800;
                            letter-spacing: -0.6px;
                            color: Theme.text_primary;
                        }

                        // Download Location and Multi-Profile Organization Settings
                        Rectangle {
                            background: Theme.bg_card;
                            border-radius: 24px;
                            border-width: 1px;
                            border-color: Theme.border_subtle;
                            drop-shadow-blur: 16px;
                            drop-shadow-color: Theme.card_shadow_color;
                            drop-shadow-offset-y: 6px;

                            VerticalLayout {
                                padding: 26px;
                                spacing: 16px;

                                Text {
                                    text: I18n.t("views.settings.location.downloadLocation", "Download Location");
                                    color: Theme.text_primary;
                                    font-size: 16px;
                                    font-weight: 700;
                                }

                                VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: I18n.t("views.settings.location.orgLabel", "Multi-Account Folder Organization");
                                        color: Theme.text_secondary;
                                        font-size: 12px;
                                        font-weight: 600;
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;

                                        for mode_label[idx] in [
                                            I18n.t("views.settings.location.modeShared", "Shared Pool (All Accounts Together)"),
                                            I18n.t("views.settings.location.modeSubfolders", "Organized by Profile Subfolder"),
                                            I18n.t("views.settings.location.modeSeparate", "Separate Custom Path per Profile")
                                        ] : Rectangle {
                                            horizontal-stretch: 1;
                                            height: 44px;
                                            border-radius: 12px;
                                            background: root.setting_storage_mode == idx
                                                ? Theme.accent
                                                : (touch_sm.has-hover ? Theme.bg_card_hover : Theme.bg_card_secondary);
                                            border-width: 1px;
                                            border-color: root.setting_storage_mode == idx ? Theme.accent_secondary : Theme.border_subtle;

                                            touch_sm := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.setting_storage_mode = idx;
                                                    root.has_unsaved_settings = true;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                alignment: center;
                                                Text {
                                                    text: mode_label;
                                                    color: root.setting_storage_mode == idx ? #ffffff : Theme.text_secondary;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: center;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: root.setting_storage_mode == 1
                                            ? I18n.t("views.settings.location.baseFolderHint", "Base Folder (Saves into <Base Folder>/<Profile>/<Course>)")
                                            : I18n.t("views.settings.location.globalFolder", "Global Download Folder");
                                        color: Theme.text_muted;
                                        font-size: 12px;
                                        font-weight: 600;
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        CustomStyledInput {
                                            horizontal-stretch: 1;
                                            text <=> root.setting_download_path;
                                            icon_commands: "M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z";
                                            edited => { root.has_unsaved_settings = true; }
                                        }
                                        Rectangle {
                                            width: 124px;
                                            height: 48px;
                                            border-radius: 14px;
                                            background: touch_browse.has-hover ? Theme.accent_secondary : Theme.accent;
                                            touch_browse := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.browse_download_path(); }
                                            }
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 8px;
                                                Text {
                                                    text: I18n.t("views.settings.location.browse", "Browse...");
                                                    color: #ffffff;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                if root.setting_storage_mode == 2 : VerticalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: "\{I18n.t("views.settings.location.dedicatedFolder", "Dedicated Folder for Active Profile")} (\{root.user_name})";
                                        color: Theme.accent;
                                        font-size: 12px;
                                        font-weight: 700;
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        CustomStyledInput {
                                            horizontal-stretch: 1;
                                            placeholder: "Leave blank to use Global Download Folder...";
                                            text <=> root.setting_profile_custom_path;
                                            icon_commands: "M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4";
                                            edited => { root.has_unsaved_settings = true; }
                                        }
                                        Rectangle {
                                            width: 124px;
                                            height: 48px;
                                            border-radius: 14px;
                                            background: touch_browse_prof.has-hover ? Theme.accent_secondary : Theme.accent;
                                            touch_browse_prof := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.browse_profile_custom_path(); }
                                            }
                                            HorizontalLayout {
                                                alignment: center;
                                                Text {
                                                    text: I18n.t("views.settings.location.browse", "Browse...");
                                                    color: #ffffff;
                                                    font-size: 13px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Interface Localization and Theme Appearance Settings
                        Rectangle {
                            background: Theme.bg_card;
                            border-radius: 24px;
                            border-width: 1px;
                            border-color: Theme.border_subtle;
                            drop-shadow-blur: 16px;
                            drop-shadow-color: Theme.card_shadow_color;
                            drop-shadow-offset-y: 6px;

                            VerticalLayout {
                                padding: 26px;
                                spacing: 16px;

                                Text {
                                    text: I18n.t("views.settings.language.title", "Application Language & Theme");
                                    color: Theme.text_primary;
                                    font-size: 16px;
                                    font-weight: 700;
                                }

                                VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: I18n.t("views.settings.language.select", "Interface Language (Auto-discovered from locales/)");
                                        color: Theme.text_secondary;
                                        font-size: 12px;
                                        font-weight: 600;
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        for loc in I18n.locales : Rectangle {
                                            height: 42px;
                                            horizontal-stretch: 1;
                                            border-radius: 12px;
                                            background: I18n.current_code == loc.code
                                                ? Theme.accent
                                                : (touch_loc.has-hover ? Theme.bg_card_hover : Theme.bg_card_secondary);
                                            border-width: 1px;
                                            border-color: I18n.current_code == loc.code ? Theme.accent_secondary : Theme.border_subtle;

                                            touch_loc := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.select_language(loc.code); }
                                            }

                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 14px;
                                                alignment: center;
                                                Text {
                                                    text: "\{loc.name} (\{loc.country_code})";
                                                    color: I18n.current_code == loc.code ? #ffffff : Theme.text_primary;
                                                    font-size: 13px;
                                                    font-weight: I18n.current_code == loc.code ? 800 : 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                Rectangle { height: 1px; background: Theme.border_subtle; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: I18n.t("views.settings.language.accentPalette", "Accent Theme Palette");
                                        color: Theme.text_primary;
                                        font-size: 14px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    HorizontalLayout {
                                        spacing: 12px;
                                        for swatch[idx] in [#9333ea, #2563eb, #10b981, #e11d48, #f59e0b] : Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 16px;
                                            background: swatch;
                                            border-width: root.theme_preset == idx ? 3px : 0px;
                                            border-color: #ffffff;
                                            drop-shadow-blur: root.theme_preset == idx ? 12px : 0px;
                                            drop-shadow-color: swatch;
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.select_theme_preset(idx); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Video Quality and Asset Preferences Settings
                        Rectangle {
                            background: Theme.bg_card;
                            border-radius: 24px;
                            border-width: 1px;
                            border-color: Theme.border_subtle;
                            drop-shadow-blur: 16px;
                            drop-shadow-color: Theme.card_shadow_color;
                            drop-shadow-offset-y: 6px;

                            VerticalLayout {
                                padding: 26px;
                                spacing: 16px;

                                Text {
                                    text: I18n.t("views.settings.preferences.downloadPref", "Download Preferences");
                                    color: Theme.text_primary;
                                    font-size: 16px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: I18n.t("views.settings.preferences.videoQual", "Preferred Video Quality");
                                    color: Theme.text_secondary;
                                    font-size: 12px;
                                    font-weight: 600;
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    for q in ["Auto", "Highest", "1080p", "720p", "480p", "360p", "Lowest"] : Rectangle {
                                        horizontal-stretch: 1;
                                        height: 40px;
                                        border-radius: 12px;
                                        background: root.setting_video_quality == q
                                            ? Theme.accent
                                            : (touch_q.has-hover ? Theme.bg_card_hover : Theme.bg_card_secondary);
                                        border-width: 1px;
                                        border-color: root.setting_video_quality == q ? Theme.accent_secondary : Theme.border_subtle;

                                        touch_q := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.setting_video_quality = q;
                                                root.has_unsaved_settings = true;
                                            }
                                        }
                                        HorizontalLayout {
                                            alignment: center;
                                            Text {
                                                text: q;
                                                color: root.setting_video_quality == q ? #ffffff : Theme.text_secondary;
                                                font-size: 13px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                Rectangle { height: 1px; background: Theme.border_subtle; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: I18n.t("views.settings.preferences.skipAttachments", "Skip Course Supplementary Attachments"); color: Theme.text_primary; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                                    CustomToggleSwitch {
                                        checked <=> root.setting_skip_attachments;
                                        toggled => { root.has_unsaved_settings = true; }
                                    }
                                }

                                Rectangle { height: 1px; background: Theme.border_subtle; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: I18n.t("views.settings.preferences.skipSub", "Skip Subtitles / Closed Captions (.vtt)"); color: Theme.text_primary; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                                    CustomToggleSwitch {
                                        checked <=> root.setting_skip_subtitles;
                                        toggled => { root.has_unsaved_settings = true; }
                                    }
                                }

                                Rectangle { height: 1px; background: Theme.border_subtle; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: I18n.t("views.settings.preferences.autoRetry", "Auto-Retry on Network Error (up to 5x)"); color: Theme.text_primary; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                                    CustomToggleSwitch {
                                        checked <=> root.setting_auto_retry;
                                        toggled => { root.has_unsaved_settings = true; }
                                    }
                                }

                                Rectangle { height: 1px; background: Theme.border_subtle; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: I18n.t("views.settings.preferences.runBackground", "Keep running in background when closed (Close to Tray)"); color: Theme.text_primary; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                                    CustomToggleSwitch {
                                        checked <=> root.setting_close_to_tray;
                                        toggled => { root.has_unsaved_settings = true; }
                                    }
                                }
                            }
                        }

                        // Network Bandwidth, Concurrency, and Scheduling Settings
                        Rectangle {
                            background: Theme.bg_card;
                            border-radius: 24px;
                            border-width: 1px;
                            border-color: Theme.border_subtle;
                            drop-shadow-blur: 16px;
                            drop-shadow-color: Theme.card_shadow_color;
                            drop-shadow-offset-y: 6px;

                            VerticalLayout {
                                padding: 26px;
                                spacing: 18px;

                                Text {
                                    text: I18n.t("views.settings.network.title", "Network, Concurrency & Scheduling");
                                    color: Theme.text_primary;
                                    font-size: 16px;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: I18n.t("views.settings.network.maxDownload", "Max Download Speed (KB/s)"); color: Theme.text_primary; font-size: 14px; font-weight: 700; }
                                        Text {
                                            text: root.setting_speed_limit_kb == 0
                                                ? I18n.t("words.unlimited", "Unlimited")
                                                : "\{root.setting_speed_limit_kb} KB/s";
                                            color: Theme.accent;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: center;
                                        Rectangle {
                                            width: 38px;
                                            height: 38px;
                                            border-radius: 10px;
                                            background: Theme.bg_card_secondary;
                                            border-width: 1px;
                                            border-color: Theme.border_subtle;
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.setting_speed_limit_kb = Math.max(0, root.setting_speed_limit_kb - 250);
                                                    root.has_unsaved_settings = true;
                                                }
                                            }
                                            Text { text: "-"; color: Theme.text_primary; font-size: 18px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            width: 96px;
                                            height: 38px;
                                            border-radius: 10px;
                                            background: Theme.bg_input;
                                            border-width: 1px;
                                            border-color: Theme.border_input;
                                            Text {
                                                text: root.setting_speed_limit_kb == 0 ? I18n.t("words.unlimited", "Unlimited") : "\{root.setting_speed_limit_kb}";
                                                color: Theme.text_primary;
                                                font-size: 13px;
                                                font-weight: 800;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Rectangle {
                                            width: 38px;
                                            height: 38px;
                                            border-radius: 10px;
                                            background: Theme.bg_card_secondary;
                                            border-width: 1px;
                                            border-color: Theme.border_subtle;
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.setting_speed_limit_kb = root.setting_speed_limit_kb + 250;
                                                    root.has_unsaved_settings = true;
                                                }
                                            }
                                            Text { text: "+"; color: Theme.text_primary; font-size: 18px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }

                                Rectangle { height: 1px; background: Theme.border_subtle; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: I18n.t("views.settings.network.maxConcurrency", "Max Concurrent Downloads"); color: Theme.text_primary; font-size: 14px; font-weight: 700; }
                                        Text { text: I18n.t("views.settings.network.maxConcurrencySub", "Simultaneous active lecture downloads (1 - 10)"); color: Theme.text_muted; font-size: 12px; }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: center;
                                        Rectangle {
                                            width: 38px;
                                            height: 38px;
                                            border-radius: 10px;
                                            background: Theme.bg_card_secondary;
                                            border-width: 1px;
                                            border-color: Theme.border_subtle;
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if root.setting_max_concurrency > 1 {
                                                        root.setting_max_concurrency = root.setting_max_concurrency - 1;
                                                        root.has_unsaved_settings = true;
                                                    }
                                                }
                                            }
                                            Text { text: "-"; color: Theme.text_primary; font-size: 18px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        Rectangle {
                                            width: 48px;
                                            height: 38px;
                                            border-radius: 10px;
                                            background: Theme.bg_input;
                                            border-width: 1px;
                                            border-color: Theme.border_input;
                                            Text {
                                                text: "\{root.setting_max_concurrency}";
                                                color: Theme.text_primary;
                                                font-size: 14px;
                                                font-weight: 800;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Rectangle {
                                            width: 38px;
                                            height: 38px;
                                            border-radius: 10px;
                                            background: Theme.bg_card_secondary;
                                            border-width: 1px;
                                            border-color: Theme.border_subtle;
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if root.setting_max_concurrency < 10 {
                                                        root.setting_max_concurrency = root.setting_max_concurrency + 1;
                                                        root.has_unsaved_settings = true;
                                                    }
                                                }
                                            }
                                            Text { text: "+"; color: Theme.text_primary; font-size: 18px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }

                                Rectangle { height: 1px; background: Theme.border_subtle; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text { text: I18n.t("views.settings.schedule.enable", "Enable Scheduled Downloads"); color: Theme.text_primary; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                                    CustomToggleSwitch {
                                        checked <=> root.setting_schedule_enabled;
                                        toggled => { root.has_unsaved_settings = true; }
                                    }
                                }

                                if root.setting_schedule_enabled : HorizontalLayout {
                                    spacing: 16px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        Text { text: I18n.t("views.settings.schedule.startTime", "Start Time (HH:MM)"); color: Theme.text_secondary; font-size: 12px; font-weight: 600; }
                                        CustomStyledInput {
                                            placeholder: "01:00";
                                            text <=> root.setting_schedule_start;
                                            icon_commands: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z";
                                            edited => { root.has_unsaved_settings = true; }
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        Text { text: I18n.t("views.settings.schedule.endTime", "End Time (HH:MM)"); color: Theme.text_secondary; font-size: 12px; font-weight: 600; }
                                        CustomStyledInput {
                                            placeholder: "06:00";
                                            text <=> root.setting_schedule_end;
                                            icon_commands: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z";
                                            edited => { root.has_unsaved_settings = true; }
                                        }
                                    }
                                }

                                Rectangle { height: 1px; background: Theme.border_subtle; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text { text: I18n.t("views.settings.vault.title", "Vault Mode (AES-256-GCM Encrypted Storage)"); color: Theme.text_primary; font-size: 14px; font-weight: 700; }
                                        Text { text: I18n.t("views.settings.vault.subtitle", "Encrypts downloaded videos, subtitles, and auth tokens on disk."); color: Theme.text_muted; font-size: 12px; }
                                    }
                                    CustomToggleSwitch {
                                        checked <=> root.setting_vault_mode;
                                        toggled => { root.has_unsaved_settings = true; }
                                    }
                                }
                            }
                        }

                        PrimaryGradientButton {
                            icon_commands: "M5 13l4 4L19 7";
                            text: root.settings_save_status != ""
                                ? root.settings_save_status
                                : I18n.t("views.settings.buttons.saveAll", "Save All Settings");
                            clicked => { root.save_settings(); }
                        }

                        if root.has_unsaved_settings : Text {
                            text: I18n.t("views.settings.unsavedModal.banner", "You have unsaved changes");
                            color: #fbbf24;
                            font-size: 13px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // About and Credits View
            if root.active_tab == 3 : ScrollView {
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        max-width: 840px;
                        horizontal-stretch: 1;
                        padding: 32px;
                        spacing: 24px;
                        alignment: start;

                        // Top Banner Card
                        Rectangle {
                            background: Theme.bg_card;
                            border-radius: 28px;
                            border-width: 1px;
                            border-color: Theme.border_subtle;
                            drop-shadow-blur: 20px;
                            drop-shadow-color: Theme.card_shadow_color;
                            drop-shadow-offset-y: 8px;

                            VerticalLayout {
                                padding: 38px;
                                spacing: 16px;
                                alignment: center;

                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 84px;
                                        height: 84px;
                                        border-radius: 24px;
                                        background: @linear-gradient(135deg, #2563eb 0%, #9333ea 100%);
                                        drop-shadow-blur: 24px;
                                        drop-shadow-color: #9333ea66;
                                        drop-shadow-offset-y: 8px;
                                        HorizontalLayout {
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                SvgIcon {
                                                    commands: "M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z";
                                                    stroke_color: #ffffff;
                                                    size: 42px;
                                                }
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text {
                                        text: "Udeler";
                                        font-size: 30px;
                                        font-weight: 900;
                                        letter-spacing: -0.6px;
                                        color: Theme.text_primary;
                                    }
                                    Text {
                                        text: "Reborn";
                                        font-size: 30px;
                                        font-weight: 900;
                                        letter-spacing: -0.6px;
                                        color: @linear-gradient(90deg, #3b82f6 0%, #a855f7 100%);
                                    }
                                }

                                Text {
                                    text: "The modern, blazing-fast, and secure way to download and archive your educational content for offline viewing.";
                                    color: Theme.text_secondary;
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // Information and Resources Grid
                        HorizontalLayout {
                            spacing: 22px;

                            // Version and Release Status Card
                            Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.bg_card;
                                border-radius: 28px;
                                border-width: 1px;
                                border-color: Theme.border_subtle;
                                drop-shadow-blur: 20px;
                                drop-shadow-color: Theme.card_shadow_color;
                                drop-shadow-offset-y: 8px;

                                VerticalLayout {
                                    padding: 32px;
                                    spacing: 14px;
                                    alignment: center;

                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 68px;
                                            height: 68px;
                                            border-radius: 34px;
                                            background: Theme.bg_card_secondary;
                                            border-width: 1px;
                                            border-color: Theme.border_subtle;
                                            HorizontalLayout {
                                                alignment: center;
                                                VerticalLayout {
                                                    alignment: center;
                                                    SvgIcon {
                                                        commands: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z";
                                                        stroke_color: Theme.text_primary;
                                                        size: 28px;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        text: "Udeler Reborn";
                                        color: Theme.text_primary;
                                        font-size: 22px;
                                        font-weight: 800;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: "Version v4.0.0 (Pure Rust)";
                                        color: Theme.text_muted;
                                        font-size: 13px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        VerticalLayout {
                                            alignment: center;
                                            SvgIcon {
                                                commands: "M5 13l4 4L19 7";
                                                stroke_color: root.update_available ? #fbbf24 : #22c55e;
                                                size: 18px;
                                                stroke_width: 3px;
                                            }
                                        }
                                        Text {
                                            text: root.update_available ? "Update Available!" : "You're up to date!";
                                            color: root.update_available ? #fbbf24 : #22c55e;
                                            font-size: 15px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: root.update_status_text;
                                        color: Theme.text_secondary;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 40px;
                                            border-radius: 12px;
                                            background: touch_update.has-hover
                                                ? (Theme.is_dark ? #ffffff18 : #e2e8f0)
                                                : Theme.bg_card_secondary;
                                            border-width: 1px;
                                            border-color: Theme.border_subtle;
                                            animate background { duration: 150ms; }
                                            touch_update := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if root.update_available && root.update_release_url != "" {
                                                        root.open_external_url(root.update_release_url);
                                                    } else {
                                                        root.check_for_updates();
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
                                                padding-left: 20px;
                                                padding-right: 20px;
                                                spacing: 8px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    SvgIcon {
                                                        commands: "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15";
                                                        stroke_color: Theme.text_primary;
                                                        size: 15px;
                                                    }
                                                }
                                                Text {
                                                    text: root.update_available ? "Download Update" : "Check for Updates";
                                                    color: Theme.text_primary;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Community Resources and Project Credits Card
                            Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.bg_card;
                                border-radius: 28px;
                                border-width: 1px;
                                border-color: Theme.border_subtle;
                                drop-shadow-blur: 20px;
                                drop-shadow-color: Theme.card_shadow_color;
                                drop-shadow-offset-y: 8px;

                                VerticalLayout {
                                    padding: 32px;
                                    spacing: 16px;
                                    alignment: space-between;

                                    Text {
                                        text: "Resources & Credits";
                                        color: Theme.text_primary;
                                        font-size: 18px;
                                        font-weight: 800;
                                    }

                                    VerticalLayout {
                                        spacing: 12px;

                                        // GitHub link
                                        Rectangle {
                                            height: 52px;
                                            border-radius: 14px;
                                            background: touch_gh.has-hover
                                                ? (Theme.is_dark ? #ffffff12 : #e2e8f0)
                                                : Theme.bg_card_secondary;
                                            border-width: 1px;
                                            border-color: Theme.border_subtle;
                                            animate background { duration: 150ms; }
                                            touch_gh := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.open_external_url("https://github.com/M3rcena/Udeler-Reborn"); }
                                            }
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                alignment: space-between;
                                                HorizontalLayout {
                                                    spacing: 12px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        SvgIcon {
                                                            commands: "M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z";
                                                            fill_color: Theme.text_primary;
                                                            stroke_width: 0px;
                                                            size: 20px;
                                                        }
                                                    }
                                                    Text { text: "GitHub Repository"; color: Theme.text_primary; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    SvgIcon {
                                                        commands: "M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14";
                                                        stroke_color: Theme.text_muted;
                                                        size: 16px;
                                                    }
                                                }
                                            }
                                        }

                                        // Discord link
                                        Rectangle {
                                            height: 52px;
                                            border-radius: 14px;
                                            background: touch_dc.has-hover
                                                ? (Theme.is_dark ? #5865F222 : #eef2ff)
                                                : Theme.bg_card_secondary;
                                            border-width: 1px;
                                            border-color: Theme.border_subtle;
                                            animate background { duration: 150ms; }
                                            touch_dc := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.open_external_url("https://discord.gg/ZgXKk6eTfC"); }
                                            }
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                alignment: space-between;
                                                HorizontalLayout {
                                                    spacing: 12px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        SvgIcon {
                                                            commands: "M13.545 2.907a13.2 13.2 0 0 0-3.257-1.011.05.05 0 0 0-.052.025c-.141.25-.297.577-.406.833a12.2 12.2 0 0 0-3.658 0 8 8 0 0 0-.412-.833.05.05 0 0 0-.052-.025c-1.125.194-2.22.534-3.257 1.011a.04.04 0 0 0-.021.018C.356 6.024-.213 9.047.066 12.032q.003.022.021.037a13.3 13.3 0 0 0 3.995 2.02.05.05 0 0 0 .056-.019q.463-.63.818-1.329a.05.05 0 0 0-.01-.059l-.018-.011a9 9 0 0 1-1.248-.595.05.05 0 0 1-.02-.066l.015-.019q.127-.095.248-.195a.05.05 0 0 1 .051-.007c2.619 1.196 5.454 1.196 8.041 0a.05.05 0 0 1 .053.007q.121.1.248.195a.05.05 0 0 1-.004.085 8 8 0 0 1-1.249.594.05.05 0 0 0-.03.03.05.05 0 0 0 .003.041c.24.465.515.909.817 1.329a.05.05 0 0 0 .056.019 13.2 13.2 0 0 0 4.001-2.02.05.05 0 0 0 .021-.037c.334-3.451-.559-6.449-2.366-9.106a.03.03 0 0 0-.02-.019m-8.198 7.307c-.789 0-1.438-.724-1.438-1.612s.637-1.613 1.438-1.613c.807 0 1.45.73 1.438 1.613 0 .888-.637 1.612-1.438 1.612m5.316 0c-.788 0-1.438-.724-1.438-1.612s.637-1.613 1.438-1.613c.807 0 1.451.73 1.438 1.613 0 .888-.631 1.612-1.438 1.612";
                                                            fill_color: #5865F2;
                                                            stroke_width: 0px;
                                                            size: 20px;
                                                            viewbox_width: 16;
                                                            viewbox_height: 16;
                                                        }
                                                    }
                                                    Text { text: "Join the Discord"; color: Theme.text_primary; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    SvgIcon {
                                                        commands: "M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14";
                                                        stroke_color: Theme.text_muted;
                                                        size: 16px;
                                                    }
                                                }
                                            }
                                        }

                                        // Sponsors link
                                        Rectangle {
                                            height: 52px;
                                            border-radius: 14px;
                                            background: touch_sponsors.has-hover
                                                ? (Theme.is_dark ? #ec489922 : #fce7f3)
                                                : Theme.bg_card_secondary;
                                            border-width: 1px;
                                            border-color: Theme.border_subtle;
                                            animate background { duration: 150ms; }
                                            touch_sponsors := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.open_external_url("https://github.com/sponsors/M3rcena"); }
                                            }
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                alignment: space-between;
                                                HorizontalLayout {
                                                    spacing: 12px;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        SvgIcon {
                                                            commands: "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z";
                                                            fill_color: #ec4899;
                                                            stroke_width: 0px;
                                                            size: 20px;
                                                        }
                                                    }
                                                    Text { text: "Support via GitHub Sponsors"; color: Theme.text_primary; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    SvgIcon {
                                                        commands: "M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14";
                                                        stroke_color: Theme.text_muted;
                                                        size: 16px;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 12px;
                                        Rectangle { height: 1px; background: Theme.border_subtle; }
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Text {
                                                text: "Remade with";
                                                color: Theme.text_muted;
                                                font-size: 13px;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                SvgIcon {
                                                    commands: "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z";
                                                    fill_color: #ec4899;
                                                    stroke_width: 0px;
                                                    size: 14px;
                                                }
                                            }
                                            Text {
                                                text: "by M3rcena";
                                                color: Theme.text_primary;
                                                font-size: 13px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Technology Stack Badges
                        HorizontalLayout {
                            alignment: center;
                            spacing: 12px;
                            for badge_text in ["RUST 2024", "SLINT V1.9", "TOKIO ASYNC", "REQWEST", "WRY NATIVE"] : Rectangle {
                                height: 34px;
                                border-radius: 17px;
                                background: Theme.is_dark ? #ffffff08 : #00000008;
                                border-width: 1px;
                                border-color: Theme.border_subtle;
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    Text { text: badge_text; color: Theme.text_muted; font-size: 11px; font-weight: 800; letter-spacing: 0.8px; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Viewport Modal Dialogs and Overlays

    // Localization Dropdown Overlay
    if root.show_language_menu && !root.is_logged_in : Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        TouchArea { clicked => { root.show_language_menu = false; } }

        Rectangle {
            x: 32px;
            y: 78px;
            width: 240px;
            height: I18n.locales.length * 44px + 16px;
            background: Theme.bg_card;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.border_subtle;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.card_shadow_color;
            drop-shadow-offset-y: 8px;

            VerticalLayout {
                padding: 8px;
                spacing: 4px;

                for loc in I18n.locales : Rectangle {
                    height: 40px;
                    border-radius: 10px;
                    background: I18n.current_code == loc.code
                        ? Theme.accent
                        : (touch_lang_item.has-hover ? Theme.bg_card_hover : transparent);
                    touch_lang_item := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.select_language(loc.code); }
                    }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;
                        Text {
                            text: "\{loc.name} (\{loc.country_code})";
                            color: I18n.current_code == loc.code ? #ffffff : Theme.text_primary;
                            font-size: 13px;
                            font-weight: I18n.current_code == loc.code ? 700 : 500;
                            vertical-alignment: center;
                        }
                        if I18n.current_code == loc.code : Text {
                            text: "✓";
                            color: #ffffff;
                            font-size: 14px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // Access Token Assistance Modal
    if root.show_token_help_modal : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000b3;
        TouchArea { clicked => { root.show_token_help_modal = false; } }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: Math.min(540px, root.width - 48px);
                    background: Theme.bg_card;
                    border-radius: 28px;
                    border-width: 1px;
                    border-color: Theme.border_subtle;
                    drop-shadow-blur: 36px;
                    drop-shadow-color: #000000aa;
                    drop-shadow-offset-y: 14px;

                    TouchArea { } // Suppress backdrop click propagation

                    VerticalLayout {
                        padding: 32px;
                        spacing: 20px;

                        HorizontalLayout {
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 14px;
                                alignment: start;
                                Rectangle {
                                    width: 46px;
                                    height: 46px;
                                    border-radius: 14px;
                                    background: #3b82f620;
                                    border-width: 1px;
                                    border-color: #3b82f640;
                                    HorizontalLayout {
                                        alignment: center;
                                        VerticalLayout {
                                            alignment: center;
                                            SvgIcon {
                                                commands: "M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z";
                                                stroke_color: #3b82f6;
                                                size: 22px;
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "Locate Your Token";
                                        color: Theme.text_primary;
                                        font-size: 20px;
                                        font-weight: 800;
                                    }
                                    Text {
                                        text: "Follow these 4 steps in your browser to link your account.";
                                        color: Theme.text_muted;
                                        font-size: 12px;
                                    }
                                }
                            }

                            Rectangle {
                                width: 34px;
                                height: 34px;
                                border-radius: 17px;
                                background: touch_modal_x.has-hover ? (Theme.is_dark ? #ffffff20 : #00000018) : transparent;
                                touch_modal_x := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.show_token_help_modal = false; }
                                }
                                HorizontalLayout {
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        SvgIcon {
                                            commands: "M6 18L18 6M6 6l12 12";
                                            stroke_color: Theme.text_secondary;
                                            size: 16px;
                                        }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 10px;

                            Rectangle {
                                background: Theme.bg_card_secondary;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: Theme.border_subtle;
                                HorizontalLayout {
                                    padding: 14px;
                                    spacing: 14px;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 14px;
                                        background: #3b82f625;
                                        Text { text: "1"; color: #3b82f6; font-size: 13px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Open your web browser and log in to your Udemy account.";
                                        color: Theme.text_secondary;
                                        font-size: 13px;
                                        font-weight: 500;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                background: Theme.bg_card_secondary;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: Theme.border_subtle;
                                HorizontalLayout {
                                    padding: 14px;
                                    spacing: 14px;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 14px;
                                        background: #3b82f625;
                                        Text { text: "2"; color: #3b82f6; font-size: 13px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Press F12 (or right-click and select 'Inspect') to open Developer Tools.";
                                        color: Theme.text_secondary;
                                        font-size: 13px;
                                        font-weight: 500;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                background: Theme.bg_card_secondary;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: Theme.border_subtle;
                                HorizontalLayout {
                                    padding: 14px;
                                    spacing: 14px;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 14px;
                                        background: #3b82f625;
                                        Text { text: "3"; color: #3b82f6; font-size: 13px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Navigate to the Application tab (Chrome/Edge) or Storage tab (Firefox).";
                                        color: Theme.text_secondary;
                                        font-size: 13px;
                                        font-weight: 500;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                background: Theme.is_dark ? #1e3a8a30 : #dbeafe;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: #3b82f655;
                                HorizontalLayout {
                                    padding: 14px;
                                    spacing: 14px;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 14px;
                                        background: #2563eb;
                                        Text { text: "4"; color: #ffffff; font-size: 13px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Expand Cookies -> click https://www.udemy.com -> copy the value of access_token.";
                                        color: Theme.is_dark ? #bfdbfe : #1e40af;
                                        font-size: 13px;
                                        font-weight: 600;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        SecondaryDarkButton {
                            text: "I've got my token";
                            clicked => { root.show_token_help_modal = false; }
                        }
                    }
                }
            }
        }
    }

    // Course Curriculum Modal Dialog
    if root.show_curriculum_modal : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000b3;
        TouchArea { clicked => { root.close_course_content(); } }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: Math.min(880px, root.width - 64px);
                    height: Math.min(640px, root.height - 64px);
                    background: Theme.bg_card;
                    border-radius: 28px;
                    border-width: 1px;
                    border-color: Theme.border_subtle;
                    drop-shadow-blur: 36px;
                    drop-shadow-color: #000000aa;
                    drop-shadow-offset-y: 14px;
                    clip: true;

                    TouchArea { } // Suppress backdrop click propagation

                    VerticalLayout {
                        padding: 24px;
                        spacing: 18px;

                        // Modal Header
                        HorizontalLayout {
                            alignment: space-between;
                            spacing: 16px;

                            HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 14px;
                                alignment: start;
                                Rectangle {
                                    width: 72px;
                                    height: 44px;
                                    border-radius: 10px;
                                    clip: true;
                                    Image {
                                        source: root.curriculum_course_thumb;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: cover;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    Text {
                                        text: root.curriculum_course_title;
                                        color: Theme.text_primary;
                                        font-size: 18px;
                                        font-weight: 800;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: "Course Curriculum";
                                        color: #3b82f6;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    height: 40px;
                                    border-radius: 12px;
                                    background: touch_dl_all.has-hover ? #3b82f6 : #2563eb;
                                    border-width: 1px;
                                    border-color: #ffffff25;
                                    drop-shadow-blur: 12px;
                                    drop-shadow-color: #2563eb55;
                                    touch_dl_all := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.download_entire_course(root.curriculum_course_id);
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            alignment: center;
                                            SvgIcon {
                                                commands: "M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4";
                                                stroke_color: #ffffff;
                                                size: 16px;
                                            }
                                        }
                                        Text { text: "Download All"; color: #ffffff; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                    }
                                }

                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: 20px;
                                    background: touch_close_curr.has-hover
                                        ? (Theme.is_dark ? #ffffff20 : #e2e8f0)
                                        : Theme.bg_card_secondary;
                                    touch_close_curr := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.close_course_content(); }
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        VerticalLayout {
                                            alignment: center;
                                            SvgIcon {
                                                commands: "M6 18L18 6M6 6l12 12";
                                                stroke_color: Theme.text_secondary;
                                                size: 18px;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.border_subtle; }

                        if root.is_loading_curriculum : VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            spacing: 14px;
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    SvgIcon {
                                        commands: "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15";
                                        stroke_color: #3b82f6;
                                        size: 36px;
                                    }
                                }
                            }
                            Text {
                                text: "Decrypting Course Curriculum...";
                                color: Theme.text_secondary;
                                font-size: 14px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                        }

                        if !root.is_loading_curriculum : ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 8px;
                                for item in root.curriculum_items : Rectangle {
                                    height: 54px;
                                    background: touch_row.has-hover ? Theme.bg_card_hover : Theme.bg_card_secondary;
                                    border-radius: 14px;
                                    border-width: 1px;
                                    border-color: touch_row.has-hover ? Theme.border_hover : Theme.border_subtle;

                                    touch_row := TouchArea { }

                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        alignment: space-between;
                                        spacing: 12px;

                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 12px;
                                            alignment: start;

                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 34px;
                                                    height: 34px;
                                                    border-radius: 10px;
                                                    background: item.item_type == "quiz"
                                                        ? #a855f722
                                                        : (item.asset_type == "Article" ? #10b98122 : #3b82f622);
                                                    HorizontalLayout {
                                                        alignment: center;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            SvgIcon {
                                                                commands: item.item_type == "quiz"
                                                                    ? "M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                                                    : (item.asset_type == "Article"
                                                                        ? "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                                                        : "M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z");
                                                                stroke_color: item.item_type == "quiz"
                                                                    ? #a855f7
                                                                    : (item.asset_type == "Article" ? #10b981 : #3b82f6);
                                                                size: 16px;
                                                            }
                                                        }
                                                    }
                                                }
                                            }

                                            Text {
                                                horizontal-stretch: 1;
                                                text: item.title;
                                                color: Theme.text_primary;
                                                font-size: 13px;
                                                font-weight: 600;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: center;

                                            if item.duration_text != "" : VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    height: 26px;
                                                    border-radius: 8px;
                                                    background: Theme.is_dark ? #ffffff0c : #0000000a;
                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        padding-right: 10px;
                                                        Text { text: item.duration_text; color: Theme.text_muted; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    height: 32px;
                                                    border-radius: 10px;
                                                    background: touch_dl_item.has-hover ? #2563eb : (Theme.is_dark ? #ffffff12 : #e2e8f0);
                                                    touch_dl_item := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.download_lecture_item(root.curriculum_course_id, item.id);
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        padding-left: 12px;
                                                        padding-right: 12px;
                                                        spacing: 6px;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            SvgIcon {
                                                                commands: "M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4";
                                                                stroke_color: touch_dl_item.has-hover ? #ffffff : Theme.text_secondary;
                                                                size: 14px;
                                                            }
                                                        }
                                                        Text {
                                                            text: "Download";
                                                            color: touch_dl_item.has-hover ? #ffffff : Theme.text_secondary;
                                                            font-size: 12px;
                                                            font-weight: 600;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Unsaved Settings Confirmation Dialog
    if root.show_unsaved_dialog : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000b3;
        TouchArea { clicked => { root.cancel_discard_settings(); } }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: Math.min(440px, root.width - 48px);
                    background: Theme.bg_card;
                    border-radius: 28px;
                    border-width: 1px;
                    border-color: Theme.border_subtle;
                    drop-shadow-blur: 36px;
                    drop-shadow-color: #000000aa;

                    TouchArea { }

                    VerticalLayout {
                        padding: 28px;
                        spacing: 18px;
                        alignment: center;

                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 56px;
                                height: 56px;
                                border-radius: 18px;
                                background: #f59e0b22;
                                HorizontalLayout {
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        SvgIcon {
                                            commands: "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z";
                                            stroke_color: #f59e0b;
                                            size: 28px;
                                        }
                                    }
                                }
                            }
                        }

                        Text {
                            text: "Unsaved Changes";
                            font-size: 20px;
                            font-weight: 800;
                            color: Theme.text_primary;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "You have unsaved changes in Settings. Do you want to discard them and switch tabs?";
                            color: Theme.text_secondary;
                            font-size: 13px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 42px;
                                border-radius: 12px;
                                background: Theme.bg_card_secondary;
                                border-width: 1px;
                                border-color: Theme.border_subtle;
                                TouchArea { mouse-cursor: pointer; clicked => { root.cancel_discard_settings(); } }
                                HorizontalLayout { alignment: center; Text { text: "Keep Editing"; color: Theme.text_primary; font-size: 13px; font-weight: 600; vertical-alignment: center; } }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 42px;
                                border-radius: 12px;
                                background: #ef4444;
                                drop-shadow-blur: 10px;
                                drop-shadow-color: #ef444455;
                                TouchArea { mouse-cursor: pointer; clicked => { root.confirm_discard_settings(); } }
                                HorizontalLayout { alignment: center; Text { text: "Discard & Switch"; color: #ffffff; font-size: 13px; font-weight: 700; vertical-alignment: center; } }
                            }
                        }
                    }
                }
            }
        }
    }
}